      "code": {
        "language": "html",
        "content": "<!DOCTYPE html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>To-Do List</title>\n    <style>\n      * { box-sizing: border-box; margin: 0; padding: 0; }\n      body { font-family: Arial, sans-serif; background: #f0f4f8; padding: 32px; }\n      .app { max-width: 480px; }\n      h1 { font-size: 22px; color: #1a202c; margin-bottom: 20px; }\n      .input-row { display: flex; gap: 8px; margin-bottom: 8px; }\n      input { flex: 1; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 14px; }\n      .btn-add { background: #3182ce; color: #fff; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: bold; }\n      #err { font-size: 13px; color: #c53030; min-height: 18px; margin-bottom: 12px; }\n      .stats { font-size: 13px; color: #718096; margin-bottom: 14px; }\n      .stats span { font-weight: bold; color: #2b6cb0; }\n      #daftar { display: flex; flex-direction: column; gap: 8px; }\n      .t-item { display: flex; align-items: center; gap: 10px; background: #fff; padding: 12px 16px; border-radius: 10px; border: 1px solid #e2e8f0; }\n      .t-teks { flex: 1; font-size: 14px; color: #2d3748; }\n      .t-teks.done { text-decoration: line-through; color: #a0aec0; }\n      .btn-ok { background: #f0fff4; color: #276749; border: 1px solid #c6f6d5; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: bold; }\n      .btn-del { background: #fff5f5; color: #c53030; border: 1px solid #fed7d7; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: bold; }\n    </style>\n  </head>\n  <body>\n    <div class=\"app\">\n      <h1>To-Do List</h1>\n      <div class=\"input-row\">\n        <input type=\"text\" id=\"inp\" placeholder=\"Tambah tugas baru...\">\n        <button class=\"btn-add\" id=\"btn-add\">Tambah</button>\n      </div>\n      <div id=\"err\"></div>\n      <div class=\"stats\">Total: <span id=\"ttl\">0</span> | Selesai: <span id=\"done\">0</span></div>\n      <div id=\"daftar\"></div>\n    </div>\n    <script>\n      function validasi(teks) { return teks.trim() !== ''; }\n      function updateStats() {\n        document.getElementById('ttl').textContent = document.querySelectorAll('.t-item').length;\n        document.getElementById('done').textContent = document.querySelectorAll('.t-teks.done').length;\n      }\n      function tambahTugas(teks) {\n        const div = document.createElement('div');\n        div.className = 't-item';\n        div.innerHTML = '<span class=\"t-teks\">' + teks + '</span><button class=\"btn-ok\">Selesai</button><button class=\"btn-del\">Hapus</button>';\n        div.querySelector('.btn-ok').addEventListener('click', function() { div.querySelector('.t-teks').classList.toggle('done'); updateStats(); });\n        div.querySelector('.btn-del').addEventListener('click', function() { div.remove(); updateStats(); });\n        document.getElementById('daftar').appendChild(div);\n        updateStats();\n      }\n      document.getElementById('btn-add').addEventListener('click', function() {\n        const teks = document.getElementById('inp').value;\n        if (!validasi(teks)) { document.getElementById('err').textContent = 'Tugas tidak boleh kosong.'; return; }\n        document.getElementById('err').textContent = '';\n        tambahTugas(teks);\n        document.getElementById('inp').value = '';\n      });\n      document.getElementById('inp').addEventListener('keydown', function(e) { if (e.key === 'Enter') document.getElementById('btn-add').click(); });\n    </script>\n  </body>\n</html>"
      }
