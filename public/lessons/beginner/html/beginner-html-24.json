    {
      "id": "node-04-add-delete",
      "type": "code",
      "title": "Langkah 2 — Tambah dan Hapus Catatan",
      "xp": 5,
      "explanation": "Menambahkan JavaScript: validasi, buat elemen catatan baru, tombol hapus, dan counter. Perhatikan event listener pada tombol hapus ditambahkan saat elemen dibuat.",
      "code": {
        "language": "html",
        "content": "<!DOCTYPE html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Mini Note App</title>\n    <style>\n      * { box-sizing: border-box; margin: 0; padding: 0; }\n      body { font-family: Arial, sans-serif; background: #f0f4f8; padding: 32px; }\n      .app { max-width: 520px; }\n      h1 { font-size: 24px; color: #1a202c; margin-bottom: 24px; }\n      .form-kartu { background: #fff; border-radius: 12px; padding: 24px; border: 1px solid #e2e8f0; margin-bottom: 24px; }\n      label { display: block; font-size: 13px; color: #4a5568; margin-bottom: 4px; font-weight: bold; }\n      input, textarea { width: 100%; padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; font-family: inherit; margin-bottom: 12px; }\n      textarea { height: 80px; resize: vertical; }\n      .btn-tambah { background: #3182ce; color: #fff; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%; }\n      #pesan-form { font-size: 13px; color: #c53030; min-height: 18px; margin-bottom: 8px; }\n      .area-catatan h2 { font-size: 16px; color: #4a5568; margin-bottom: 12px; }\n      #jumlah-catatan { font-weight: bold; color: #2b6cb0; }\n      #daftar-catatan { display: flex; flex-direction: column; gap: 12px; }\n      .catatan-item { background: #fff; border-radius: 10px; padding: 18px; border: 1px solid #e2e8f0; }\n      .c-judul { font-size: 15px; font-weight: bold; color: #1a202c; margin-bottom: 6px; }\n      .c-isi { font-size: 14px; color: #4a5568; line-height: 1.5; margin-bottom: 12px; }\n      .btn-hapus { background: #fff5f5; color: #c53030; border: 1px solid #fed7d7; padding: 5px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: bold; }\n    </style>\n  </head>\n  <body>\n    <div class=\"app\">\n      <h1>Catatan Mini</h1>\n      <div class=\"form-kartu\">\n        <div id=\"pesan-form\"></div>\n        <label>Judul</label>\n        <input type=\"text\" id=\"input-judul\" placeholder=\"Judul catatan...\">\n        <label>Isi Catatan</label>\n        <textarea id=\"input-isi\" placeholder=\"Tulis isinya...\"></textarea>\n        <button class=\"btn-tambah\" id=\"btn-tambah\">+ Tambah Catatan</button>\n      </div>\n      <div class=\"area-catatan\">\n        <h2>Catatan (<span id=\"jumlah-catatan\">0</span>)</h2>\n        <div id=\"daftar-catatan\"></div>\n      </div>\n    </div>\n    <script>\n      let idCounter = 0;\n\n      function validasiForm(judul, isi) {\n        if (!judul.trim()) return 'Judul tidak boleh kosong.';\n        if (!isi.trim()) return 'Isi catatan tidak boleh kosong.';\n        return '';\n      }\n\n      function hapusCatatan(el) { el.remove(); updateCounter(); }\n\n      function buatElemen(id, judul, isi) {\n        const div = document.createElement('div');\n        div.className = 'catatan-item';\n        div.innerHTML = '<div class=\"c-judul\">' + judul + '</div>'\n          + '<div class=\"c-isi\">' + isi + '</div>'\n          + '<button class=\"btn-hapus\">Hapus</button>';\n        div.querySelector('.btn-hapus').addEventListener('click', function() { hapusCatatan(div); });\n        return div;\n      }\n\n      function updateCounter() {\n        document.getElementById('jumlah-catatan').textContent =\n          document.getElementById('daftar-catatan').children.length;\n      }\n\n      function bersihkanForm() {\n        document.getElementById('input-judul').value = '';\n        document.getElementById('input-isi').value = '';\n        document.getElementById('pesan-form').textContent = '';\n      }\n\n      function tambahCatatan() {\n        const judul = document.getElementById('input-judul').value;\n        const isi = document.getElementById('input-isi').value;\n        const err = validasiForm(judul, isi);\n        if (err) { document.getElementById('pesan-form').textContent = err; return; }\n        idCounter++;\n        document.getElementById('daftar-catatan').appendChild(buatElemen(idCounter, judul, isi));\n        updateCounter();\n        bersihkanForm();\n      }\n\n      document.getElementById('btn-tambah').addEventListener('click', tambahCatatan);\n    </script>\n  </body>\n</html>"
      }
    },
    {
      "id": "node-05-realtime",
      "type": "code",
      "title": "Langkah 3 — Real-time Feedback",
      "xp": 5,
      "explanation": "Tambahkan karakter counter real-time pada input dan textarea menggunakan event input. Pengguna mendapat feedback langsung saat mengetik.",
      "code": {
        "language": "html",
        "content": "<!DOCTYPE html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Mini Note App</title>\n    <style>\n      * { box-sizing: border-box; margin: 0; padding: 0; }\n      body { font-family: Arial, sans-serif; background: #f0f4f8; padding: 32px; }\n      .app { max-width: 520px; }\n      h1 { font-size: 24px; color: #1a202c; margin-bottom: 24px; }\n      .form-kartu { background: #fff; border-radius: 12px; padding: 24px; border: 1px solid #e2e8f0; margin-bottom: 24px; }\n      label { display: block; font-size: 13px; color: #4a5568; margin-bottom: 4px; font-weight: bold; }\n      input, textarea { width: 100%; padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; font-family: inherit; }\n      textarea { height: 80px; resize: vertical; }\n      .field-wrap { margin-bottom: 12px; }\n      .hint { font-size: 12px; color: #a0aec0; margin-top: 3px; }\n      .btn-tambah { background: #3182ce; color: #fff; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%; margin-top: 8px; }\n      #pesan-form { font-size: 13px; color: #c53030; min-height: 18px; margin-bottom: 8px; }\n      .area-catatan h2 { font-size: 16px; color: #4a5568; margin-bottom: 12px; }\n      #jumlah-catatan { font-weight: bold; color: #2b6cb0; }\n      #daftar-catatan { display: flex; flex-direction: column; gap: 12px; }\n      .catatan-item { background: #fff; border-radius: 10px; padding: 18px; border: 1px solid #e2e8f0; }\n      .c-judul { font-size: 15px; font-weight: bold; color: #1a202c; margin-bottom: 6px; }\n      .c-isi { font-size: 14px; color: #4a5568; line-height: 1.5; margin-bottom: 12px; }\n      .btn-hapus { background: #fff5f5; color: #c53030; border: 1px solid #fed7d7; padding: 5px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: bold; }\n    </style>\n  </head>\n  <body>\n    <div class=\"app\">\n      <h1>Catatan Mini</h1>\n      <div class=\"form-kartu\">\n        <div id=\"pesan-form\"></div>\n        <div class=\"field-wrap\">\n          <label>Judul</label>\n          <input type=\"text\" id=\"input-judul\" placeholder=\"Judul catatan...\" maxlength=\"60\">\n          <div class=\"hint\" id=\"hint-judul\">0 / 60</div>\n        </div>\n        <div class=\"field-wrap\">\n          <label>Isi Catatan</label>\n          <textarea id=\"input-isi\" placeholder=\"Tulis isinya...\" maxlength=\"300\"></textarea>\n          <div class=\"hint\" id=\"hint-isi\">0 / 300</div>\n        </div>\n        <button class=\"btn-tambah\" id=\"btn-tambah\">+ Tambah Catatan</button>\n      </div>\n      <div class=\"area-catatan\">\n        <h2>Catatan (<span id=\"jumlah-catatan\">0</span>)</h2>\n        <div id=\"daftar-catatan\"></div>\n      </div>\n    </div>\n    <script>\n      let idCounter = 0;\n\n      document.getElementById('input-judul').addEventListener('input', function() {\n        document.getElementById('hint-judul').textContent = this.value.length + ' / 60';\n      });\n      document.getElementById('input-isi').addEventListener('input', function() {\n        document.getElementById('hint-isi').textContent = this.value.length + ' / 300';\n      });\n\n      function validasiForm(judul, isi) {\n        if (!judul.trim()) return 'Judul tidak boleh kosong.';\n        if (!isi.trim()) return 'Isi catatan tidak boleh kosong.';\n        return '';\n      }\n      function hapusCatatan(el) { el.remove(); updateCounter(); }\n      function buatElemen(id, judul, isi) {\n        const div = document.createElement('div');\n        div.className = 'catatan-item';\n        div.innerHTML = '<div class=\"c-judul\">' + judul + '</div><div class=\"c-isi\">' + isi + '</div><button class=\"btn-hapus\">Hapus</button>';\n        div.querySelector('.btn-hapus').addEventListener('click', function() { hapusCatatan(div); });\n        return div;\n      }\n      function updateCounter() {\n        document.getElementById('jumlah-catatan').textContent = document.getElementById('daftar-catatan').children.length;\n      }\n      function bersihkanForm() {\n        document.getElementById('input-judul').value = '';\n        document.getElementById('input-isi').value = '';\n        document.getElementById('pesan-form').textContent = '';\n        document.getElementById('hint-judul').textContent = '0 / 60';\n        document.getElementById('hint-isi').textContent = '0 / 300';\n      }\n      function tambahCatatan() {\n        const judul = document.getElementById('input-judul').value;\n        const isi = document.getElementById('input-isi').value;\n        const err = validasiForm(judul, isi);\n        if (err) { document.getElementById('pesan-form').textContent = err; return; }\n        idCounter++;\n        document.getElementById('daftar-catatan').appendChild(buatElemen(idCounter, judul, isi));\n        updateCounter(); bersihkanForm();\n      }\n      document.getElementById('btn-tambah').addEventListener('click', tambahCatatan);\n    </script>\n  </body>\n</html>"
      }
    },
    {
      "id": "node-06-full-app",
      "type": "code",
      "title": "Aplikasi Catatan Mini — Versi Final",
      "xp": 5,
      "explanation": "Versi final lengkap dan bersih dengan semua fitur: tambah, hapus, validasi, counter, real-time feedback. Kode terorganisir dengan komentar seksi.",
      "code": {
        "language": "html",
        "content": "<!DOCTYPE html>\n<html lang=\"id\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Mini Note App</title>\n    <style>\n      * { box-sizing: border-box; margin: 0; padding: 0; }\n      body { font-family: Arial, sans-serif; background: #f0f4f8; padding: 32px; }\n      .app { max-width: 540px; }\n      h1 { font-size: 24px; color: #1a202c; margin-bottom: 6px; }\n      .sub { font-size: 14px; color: #718096; margin-bottom: 24px; }\n      .form-kartu { background: #fff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; margin-bottom: 24px; }\n      label { display: block; font-size: 13px; color: #4a5568; font-weight: bold; margin-bottom: 4px; }\n      input, textarea { width: 100%; padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; font-family: inherit; }\n      textarea { height: 80px; resize: vertical; }\n      .fw { margin-bottom: 12px; }\n      .hint { font-size: 12px; color: #a0aec0; margin-top: 3px; }\n      #pesan-form { font-size: 13px; color: #c53030; min-height: 18px; margin-bottom: 8px; }\n      .btn-tambah { background: #3182ce; color: #fff; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%; }\n      .area-h { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }\n      .area-h h2 { font-size: 16px; color: #4a5568; }\n      #badge-n { background: #ebf8ff; color: #2b6cb0; font-size: 13px; font-weight: bold; padding: 3px 10px; border-radius: 20px; }\n      #kosong { text-align: center; color: #a0aec0; font-size: 14px; padding: 24px 0; }\n      #daftar-catatan { display: flex; flex-direction: column; gap: 12px; }\n      .catatan-item { background: #fff; border-radius: 12px; padding: 18px; border: 1px solid #e2e8f0; }\n      .c-judul { font-size: 15px; font-weight: bold; color: #1a202c; margin-bottom: 6px; }\n      .c-isi { font-size: 14px; color: #4a5568; line-height: 1.55; margin-bottom: 14px; }\n      .c-foot { display: flex; justify-content: flex-end; }\n      .btn-hapus { background: #fff5f5; color: #c53030; border: 1px solid #fed7d7; padding: 5px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: bold; }\n    </style>\n  </head>\n  <body>\n    <div class=\"app\">\n      <h1>Catatan Mini</h1>\n      <p class=\"sub\">Tulis dan simpan catatanmu dengan mudah.</p>\n      <div class=\"form-kartu\">\n        <div id=\"pesan-form\"></div>\n        <div class=\"fw\"><label>Judul</label><input type=\"text\" id=\"input-judul\" placeholder=\"Judul catatan...\" maxlength=\"60\"><div class=\"hint\" id=\"hint-j\">0/60</div></div>\n        <div class=\"fw\"><label>Isi</label><textarea id=\"input-isi\" placeholder=\"Tulis isinya...\" maxlength=\"300\"></textarea><div class=\"hint\" id=\"hint-i\">0/300</div></div>\n        <button class=\"btn-tambah\" id=\"btn-tambah\">+ Tambah Catatan</button>\n      </div>\n      <div class=\"area-h\">\n        <h2>Catatan Tersimpan</h2>\n        <span id=\"badge-n\">0 catatan</span>\n      </div>\n      <div id=\"kosong\">Belum ada catatan. Tambahkan yang pertama!</div>\n      <div id=\"daftar-catatan\"></div>\n    </div>\n    <script>\n      /* ===== STATE ===== */\n      let id = 0;\n      /* ===== VALIDASI ===== */\n      function validasiForm(j, i) {\n        if (!j.trim()) return 'Judul tidak boleh kosong.';\n        if (!i.trim()) return 'Isi tidak boleh kosong.';\n        return '';\n      }\n      /* ===== UPDATE UI ===== */\n      function updateCounter() {\n        const n = document.getElementById('daftar-catatan').children.length;\n        document.getElementById('badge-n').textContent = n + ' catatan';\n        document.getElementById('kosong').style.display = n === 0 ? 'block' : 'none';\n      }\n      function bersihkanForm() {\n        document.getElementById('input-judul').value = '';\n        document.getElementById('input-isi').value = '';\n        document.getElementById('pesan-form').textContent = '';\n        document.getElementById('hint-j').textContent = '0/60';\n        document.getElementById('hint-i').textContent = '0/300';\n      }\n      /* ===== HAPUS ===== */\n      function hapusCatatan(el) { el.remove(); updateCounter(); }\n      /* ===== BUAT ELEMEN ===== */\n      function buatElemen(id, judul, isi) {\n        const div = document.createElement('div');\n        div.className = 'catatan-item';\n        div.innerHTML = '<div class=\"c-judul\">' + judul + '</div><div class=\"c-isi\">' + isi + '</div><div class=\"c-foot\"><button class=\"btn-hapus\">Hapus</button></div>';\n        div.querySelector('.btn-hapus').addEventListener('click', function() { hapusCatatan(div); });\n        return div;\n      }\n      /* ===== TAMBAH ===== */\n      function tambahCatatan() {\n        const j = document.getElementById('input-judul').value;\n        const i = document.getElementById('input-isi').value;\n        const err = validasiForm(j, i);\n        if (err) { document.getElementById('pesan-form').textContent = err; return; }\n        id++;\n        document.getElementById('daftar-catatan').appendChild(buatElemen(id, j, i));\n        updateCounter(); bersihkanForm();\n      }\n      /* ===== EVENTS ===== */\n      document.getElementById('btn-tambah').addEventListener('click', tambahCatatan);\n      document.getElementById('input-judul').addEventListener('input', function() { document.getElementById('hint-j').textContent = this.value.length + '/60'; });\n      document.getElementById('input-isi').addEventListener('input', function() { document.getElementById('hint-i').textContent = this.value.length + '/300'; });\n      /* ===== INIT ===== */\n      updateCounter();\n    </script>\n  </body>\n</html>"
      }
    },
    {
      "id": "node-07-todo-app",
      "type": "code",
      "title": "Contoh Alternatif — To-Do List",
      "xp": 5,
